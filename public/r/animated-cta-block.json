  "description": "Conversion-optimized terminal deployment CTA with instant command copy and status pulse.",
  "category": "sections",
  "dependencies": [
    "clsx",
    "tailwind-merge",
    "@phosphor-icons/react"
  ],
  "devDependencies": [],
  "registryDependencies": [],
