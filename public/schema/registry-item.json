{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cooki UI Registry Item",
  "type": "object",
  "required": ["name", "type", "title", "description", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "devDependencies": { "type": "array", "items": { "type": "string" } },
    "registryDependencies": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "target"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "target": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    }
  }
}
